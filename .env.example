# Bu dosyayı .env olarak kopyalayın.
WEB_PORT=8080
# Gerçek model çağrıları için anahtarı buraya ekleyin ve satırın başındaki işareti kaldırın.
# VA_OPENROUTER_API_KEY=
# İlk kurulumdan sonra (modeller indikten sonra) internetsiz açılış için:
# VA_MODELS_OFFLINE=true

# Taranmış sayfaların (metin katmanı olmayan) okuyucusu. Boşsa bu sayfaları olan belgeler
# "Okuyucu bekleniyor" durumunda kalır. Windows / ekran kartsız: local (model uygulamanın içinde).
# Mac: önce "mlx_vlm.server --port 8111", sonra mlx-vlm-server@http://localhost:8111/
# VA_PAGE_READER=local
